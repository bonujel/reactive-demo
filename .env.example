# 源链配置（例如：Sepolia）
ORIGIN_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ORIGIN_CHAIN_ID=11155111
ORIGIN_PRIVATE_KEY=your_private_key_here

# 目标链配置（例如：Sepolia）
DESTINATION_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
DESTINATION_CHAIN_ID=11155111
DESTINATION_PRIVATE_KEY=your_private_key_here

# Reactive Network 配置（Lasna Testnet）
REACTIVE_RPC=https://lasna-rpc.rnk.dev
REACTIVE_CHAIN_ID=5318007
REACTIVE_PRIVATE_KEY=your_private_key_here

# Reactive Network 系统合约地址（Lasna Testnet）
SYSTEM_CONTRACT_ADDR=0x0000000000000000000000000000000000FFFFFF

# 目标链回调代理地址（Sepolia）
# 该地址必须使用目标链官方 callback proxy，而不是 Lasna 的 0x000...fffFfF 系统地址。
DESTINATION_CALLBACK_PROXY_ADDR=0xc9f36411C9897e7F959D99ffca2a0Ba7ee0D7bDA

# 部署后的合约地址（部署后填写）
ORIGIN_ADDR=
CALLBACK_ADDR=
REACTIVE_ADDR=
