# 源链配置（例如：Sepolia）
ORIGIN_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ORIGIN_CHAIN_ID=11155111
ORIGIN_PRIVATE_KEY=your_private_key_here

# 目标链配置（例如：Sepolia）
DESTINATION_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
DESTINATION_CHAIN_ID=11155111
DESTINATION_PRIVATE_KEY=your_private_key_here

# Reactive Network 配置
REACTIVE_RPC=https://kopli-rpc.rkt.ink
REACTIVE_PRIVATE_KEY=your_private_key_here

# Reactive Network 系统合约地址（Kopli Testnet）
SYSTEM_CONTRACT_ADDR=0x0000000000000000000000000000000000FFFFFF

# 目标链回调代理地址（Sepolia）
DESTINATION_CALLBACK_PROXY_ADDR=0x33Bbb7D0a2F1029550B0e91f653c4055DC9F4Dd8

# 部署后的合约地址（部署后填写）
ORIGIN_ADDR=
CALLBACK_ADDR=
REACTIVE_ADDR=
